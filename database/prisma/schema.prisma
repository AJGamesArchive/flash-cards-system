datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Users {
  userUUID              String    @id @default(uuid()) @unique
  username              String    @unique
  password              String
  adminFlag             Boolean   @default(false)
  loginToken            String?
  userSince             DateTime  @default(now())
  apiAccount            Boolean   @default(false)
  deleted               Boolean   @default(false)
  sets                  Sets[]
  setReview             SetReview[]
  collections           Collections[]
  hiddenCardAllocation  HiddenCardAllocation[]
}

model Sets {
  setUUID               String    @id @default(uuid()) @unique
  name                  String
  description           String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  authorUUID            String
  author                Users     @relation(fields: [authorUUID], references: [userUUID], onDelete: Cascade)
  setReview             SetReview[]
  collectionAllocation  CollectionAllocations[]
  flashCards            FlashCards[]
}

model SetReview {
  reviewUUID  String    @id @default(uuid()) @unique
  review      String
  starRating  Int
  reviewDate  DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  authorUUID  String?
  setUUID     String
  author      Users?    @relation(fields: [authorUUID], references: [userUUID])
  set         Sets      @relation(fields: [setUUID], references: [setUUID], onDelete: Cascade)
}

model Collections {
  collectionUUID        String    @id @default(uuid()) @unique
  name                  String
  description           String
  createdOn             DateTime  @default(now())
  authorUUID            String
  author                Users     @relation(fields: [authorUUID], references: [userUUID], onDelete: Cascade)
  collectionAllocation  CollectionAllocations[]
}

model CollectionAllocations {
  setUUID         String
  collectionUUID  String
  set             Sets        @relation(fields: [setUUID], references: [setUUID], onDelete: Cascade)
  collection      Collections @relation(fields: [collectionUUID], references: [collectionUUID], onDelete: Cascade)
  @@id([setUUID, collectionUUID])
}

model Difficulties {
  difficultyUUID  String  @id @default(uuid()) @unique
  value           String  @unique
  flashCards      FlashCards[]
}

model FlashCards {
  cardUUID              String        @id @default(uuid()) @unique
  question              String
  answer                String
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  setUUID               String
  difficultyUUID        String?
  set                   Sets          @relation(fields: [setUUID], references: [setUUID], onDelete: Cascade)
  difficulty            Difficulties? @relation(fields: [difficultyUUID], references: [difficultyUUID])
  hiddenCardAllocation  HiddenCardAllocation[]
  flashCardUsageLog     FlashCardUsageLogs[]
}

model HiddenCardAllocation {
  userUUID        String
  cardUUID        String
  user            Users       @relation(fields: [userUUID], references: [userUUID], onDelete: Cascade)
  card            FlashCards  @relation(fields: [cardUUID], references: [cardUUID], onDelete: Cascade)
  @@id([userUUID, cardUUID])
}

model FlashCardUsageLogs {
  logUUID       String      @id @default(uuid()) @unique
  faceDownTime  Int
  revisionTime  Int
  timesFlipped  Int
  cardUUID      String?
  card          FlashCards? @relation(fields: [cardUUID], references: [cardUUID])
}

model SystemConfig {
  configUUID        String    @id @default(uuid()) @unique
  setCreationLimit  Int
  creationCounter   Int       @default(0)
  currentDate       DateTime  @default(now())
}